# ==========================================================
# CONFIGURAZIONE XRPL TESTNET
# ==========================================================
# ATTENZIONE: Questo è solo un modello di esempio.
# I seed reali vengono salvati in .env dallo script wallet_setup.py.
# NON committare MAI il file .env su GitHub!
# ==========================================================

# Wallet della Piattaforma (chi conia e gestisce le card)
PLATFORM_ADDRESS=r...
PLATFORM_SEED=s...

# Wallet del Fan (utente che riceve la card)
FAN_ADDRESS=r...
FAN_SEED=s...

# URL del nodo Testnet XRPL
XRPL_TESTNET_URL=https://s.altnet.rippletest.net:51234
