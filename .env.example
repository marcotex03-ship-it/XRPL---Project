# ==========================================================
# XRPL TESTNET CONFIGURATION TEMPLATE
# ==========================================================
# NOTICE: This is an example template.
# Real seeds are generated and stored in .env by wallet_setup.py.
# NEVER commit the .env file to GitHub!
# ==========================================================

# Platform Wallet (Issuer / Minter of Fan Cards)
PLATFORM_ADDRESS=r...
PLATFORM_SEED=s...

# Fan Wallet (Receiver / End user)
FAN_ADDRESS=r...
FAN_SEED=s...

# XRPL Testnet Node URL
XRPL_TESTNET_URL=https://s.altnet.rippletest.net:51234
